{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clozito",
  "version": "1.2.2",
  "identifier": "com.clozito.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clozito — Apparel, Inventory & Production Management",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Clozito — Apparel, Inventory & Production Management Platform",
    "longDescription": "Clozito is an all-in-one apparel, footwear, inventory, and garment production management platform with local offline SQLite storage and real-time cloud synchronization."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NTE3Q0IyQkYxRjYyRjMKUldUelloKy9zbnhSUi9CNlYwVVR3QWt0aFdRc3FpVnlPaTE5VE1TRkJ2UmtSMTBpWHE0MnBud3IK",
      "endpoints": [
        "https://dl.clozito.com/latest.json",
        "https://dl.clozito.com/desktop/latest.json",
        "https://github.com/clozito/clozito-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
